# Local development configuration. Copy to .env and adjust as needed:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL (pgvector) ---
# These defaults are local-development values only. They are the same credentials the
# compose file falls back to, so an existing postgres_data volume keeps working.
# Anything beyond a local machine needs a real password set here.
POSTGRES_USER=troubleshoot_user
POSTGRES_PASSWORD=troubleshoot_password
POSTGRES_DB=troubleshooting
POSTGRES_HOST=localhost
# Host port 5433, not 5432: a stock PostgreSQL install or another project's
# container commonly already owns 5432. The container still listens on 5432 internally.
POSTGRES_PORT=5433

# --- Phase 0-2 language model ---
# Required. The enrichment and extraction stages call Gemini, and the service fails to
# start without a key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides; the pipeline falls back to the lite model on the primary's failure.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Embedding model ---
# EMBEDDING_DIM must match the model. Changing either requires re-running the migration
# against an empty database, because pgvector columns are fixed-width.
# pgvector caps HNSW-indexable `vector` columns at 2000 dimensions.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# ONNX inference threads. Capping this avoids oversubscribing cores the Gemini SDK,
# the connection pool and uvicorn also need; 2 measured ~10x faster than the
# library default on a 16-core machine. Tune per host; 0 uses the library default.
EMBEDDING_THREADS=2

# --- Retrieval and cache tuning (see app/config.py for measured rationale) ---
CACHE_SIMILARITY_THRESHOLD=0.78
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH_CATALOG=100
HNSW_EF_SEARCH_CACHE=40
CATALOG_TOP_K=5

# --- Data sources (official participant kit) ---
CATALOG_PATH=data/official/deeplinks.json
QUERIES_PATH=data/official/siis_responses.json
