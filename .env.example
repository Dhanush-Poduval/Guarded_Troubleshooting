# Local development configuration. Copy to .env and adjust as needed:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL (pgvector) ---
# These defaults are local-development values only. They are the same credentials the
# compose file falls back to, so an existing postgres_data volume keeps working.
# Anything beyond a local machine needs a real password set here.
POSTGRES_USER=troubleshoot_user
POSTGRES_PASSWORD=troubleshoot_password
POSTGRES_DB=troubleshooting
POSTGRES_HOST=localhost
# Host port 5433, not 5432: a stock PostgreSQL install or another project's
# container commonly already owns 5432. The container still listens on 5432 internally.
POSTGRES_PORT=5433

# --- Embedding model ---
# EMBEDDING_DIM must match the model. Changing either requires re-running the migration
# against an empty database, because pgvector columns are fixed-width.
# pgvector caps HNSW-indexable `vector` columns at 2000 dimensions.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval and cache tuning (see app/config.py for measured rationale) ---
CACHE_SIMILARITY_THRESHOLD=0.78
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH_CATALOG=100
HNSW_EF_SEARCH_CACHE=40
CATALOG_TOP_K=5

# --- Data sources (synthetic fixtures until the official dataset arrives) ---
CATALOG_PATH=data/fixtures_synthetic/deeplinks.json
QUERIES_PATH=data/fixtures_synthetic/queries.json
